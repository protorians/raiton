{
  "name": "raiton",
  "version": "6.11.0-beta.29",
  "private": false,
  "type": "module",
  "description": "Modular TypeScript Backend Framework with Dependency Injection, Plugins, Controllers, Middleware and Hot Reloading",
  "main": "./source/core/index.ts",
  "module": "./source/core/index.ts",
  "types": "./build/types/core/index.d.ts",
  "bin": {
    "raiton": "source/bin/index.ts"
  },
  "keywords": [
    "protorians",
    "raiton",
    "framework",
    "typescript",
    "node",
    "bun",
    "deno",
    "backend"
  ],
  "author": "Y. Yannick GOBOU",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/protorians/raiton.git"
  },
  "exports": {
    ".": {
      "types": "./build/types/core/index.d.ts",
      "import": "./source/core/index.ts",
      "default": "./source/core/index.ts"
    },
    "./core": {
      "types": "./build/types/core/index.d.ts",
      "import": "./source/core/index.ts",
      "default": "./source/core/index.ts"
    },
    "./core/*": "./source/core/*.ts",
    "./commands/*": "./source/commands/*.ts",
    "./cli": "./source/bin/index.ts",
    "./framework": {
      "types": "./build/types/framework/index.d.ts",
      "import": "./source/framework/index.ts",
      "default": "./source/framework/index.ts"
    },
    "./framework/decorators": {
      "types": "./build/types/framework/decorators/index.d.ts",
      "import": "./source/framework/decorators/index.ts",
      "default": "./source/framework/decorators/index.ts"
    },
    "./framework/decorators/*": "./source/framework/decorators/*.ts",
    "./framework/*": "./source/framework/*.ts",
    "./contracts": {
      "types": "./build/types/contracts/index.d.ts",
      "import": "./source/contracts/index.ts",
      "default": "./source/contracts/index.ts"
    },
    "./contracts/*": "./source/contracts/*.ts",
    "./manifest": {
      "types": "./build/types/manifest/index.d.ts",
      "import": "./source/manifest/index.ts",
      "default": "./source/manifest/index.ts"
    },
    "./manifest/*": "./source/manifest/*.ts",
    "./types": "./source/types/index.ts",
    "./types/*": "./source/types/*.ts"
  },
  "scripts": {
    "dev": "bun run --hot source/bin/index.ts dev",
    "dev:node": "node build/bin/index.mjs dev",
    "dev:deno": "deno task dev",
    "build": "bun build source/bin/index.ts --target=node --format=esm --outfile=build/bin/index.mjs && bun run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "bench": "bun run scripts/bench.ts",
    "bench:ai": "bun run scripts/bench-ai-debug.ts",
    "test": "bun test tests",
    "start": "bun run source/bin/index.ts start",
    "start:node": "node build/bin/index.mjs start",
    "start:deno": "deno task start",
    "compile:deno": "deno task compile",
    "version": "bun run scripts/update-version.ts",
    "postinstall": "node scripts/postinstall.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@protorians/core": "^0.6.13",
    "@protorians/events-bus": "^0.0.1",
    "@protorians/logger": "^0.0.10",
    "@protorians/parameters": "^0.0.5",
    "@sinclair/typebox": "^0.34.41",
    "@types/node": "^25.0.3",
    "argon2": "^0.44.0",
    "bcrypt": "^6.0.0",
    "class-validator": "^0.14.3",
    "commander": "^14.0.2",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bun": "^1.4.2",
    "@types/deno": "^2.5.0",
    "gpt-tokenizer": "^4.1.2",
    "typescript": "^7.0.2"
  },
  "compilerOptions": {
    "types": [
      "bun",
      "deno"
    ]
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
